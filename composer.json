{
  "name": "uaegoldprices/gold-calculator",
  "description": "Gold value calculator for the UAE: 24/22/21/18/14K prices per gram, tola and troy ounce, making charges, 5% VAT and zakat (85 g nisab). Arabic-Indic digits and Arabic unit names accepted. Zero dependencies.",
  "type": "library",
  "keywords": ["gold", "gold-price", "karat", "uae", "dubai", "aed", "zakat", "vat", "tola", "calculator"],
  "homepage": "https://uaegoldprices.ae/",
  "license": "MIT",
  "authors": [{ "name": "UAE Gold Prices", "homepage": "https://uaegoldprices.ae/" }],
  "support": {
    "issues": "https://github.com/nbkdevs/uae-gold-prices/issues",
    "source": "https://github.com/nbkdevs/uae-gold-prices"
  },
  "require": { "php": ">=8.1", "ext-mbstring": "*" },
  "require-dev": { "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0" },
  "autoload": { "psr-4": { "UaeGoldPrices\\GoldCalculator\\": "packages/packagist/src/" } },
  "autoload-dev": { "psr-4": { "UaeGoldPrices\\GoldCalculator\\Tests\\": "packages/packagist/tests/" } },
  "bin": ["packages/packagist/bin/uae-gold-calculator"],
  "scripts": { "test": "phpunit -c packages/packagist/phpunit.xml" },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
