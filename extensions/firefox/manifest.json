{
  "manifest_version": 3,
  "name": "Karat Gold Value Calculator",
  "short_name": "Gold Calculator",
  "version": "1.0.0",
  "description": "Offline gold calculator: karat prices per gram, tola and ounce, item price with making charge and VAT, zakat and units. AR/EN.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Karat Gold Value Calculator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "karat-gold-calculator@nbkdevs",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}